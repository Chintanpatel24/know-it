#!/usr/bin/env bash
# know-it - Fast GitHub repository ingestion & analysis helper for AI agents
# Part of know-it skill suite (https://github.com/Chintanpatel24/know-it)

set -euo pipefail

VERSION="1.0.0"
CACHE_BASE="${KNOW_IT_CACHE:-${KNOW_HOW_CACHE:-$HOME/.cache/know-it}}"

# Colors
BOLD="\033[1m"
GREEN="\033[32m"
BLUE="\033[34m"
YELLOW="\033[33m"
RED="\033[31m"
CYAN="\033[36m"
RESET="\033[0m"

log_info()  { echo -e "${BLUE}ℹ${RESET} $*" >&2; }
log_ok()    { echo -e "${GREEN}✓${RESET} $*" >&2; }
log_warn()  { echo -e "${YELLOW}⚠${RESET} $*" >&2; }
log_err()   { echo -e "${RED}✗${RESET} $*" >&2; }

# Normalize any GitHub URL, git SSH string, or "owner/repo" slug
normalize_repo() {
    local input="$1"
    local slug=""

    # Remove trailing .git and trailing slashes
    input="${input%.git}"
    input="${input%/}"

    if [[ "$input" =~ ^https?://github\.com/([^/]+)/([^/]+) ]]; then
        slug="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
    elif [[ "$input" =~ ^git@github\.com:([^/]+)/([^/]+) ]]; then
        slug="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
    elif [[ "$input" =~ ^([^/]+)/([^/]+)$ ]]; then
        slug="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
    else
        log_err "Invalid GitHub repository format: $input"
        echo "Expected: 'owner/repo' or 'https://github.com/owner/repo'" >&2
        return 1
    fi

    # Strip subpaths like /tree/main/...
    local owner="${slug%%/*}"
    local rest="${slug#*/}"
    local repo="${rest%%/*}"
    echo "${owner}/${repo}"
}

get_cache_path() {
    local slug="$1"
    echo "${CACHE_BASE}/${slug}"
}

cmd_fetch() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        log_err "Usage: know-it fetch <github-url-or-slug>"
        exit 1
    fi

    local slug
    slug=$(normalize_repo "$target")
    local cache_dir
    cache_dir=$(get_cache_path "$slug")
    local clone_url="https://github.com/${slug}.git"

    mkdir -p "$(dirname "$cache_dir")"

    if [[ -d "${cache_dir}/.git" ]]; then
        log_info "Updating cached repository: ${slug} in ${cache_dir}"
        git -C "$cache_dir" fetch --depth 1 origin 2>/dev/null || true
        git -C "$cache_dir" reset --hard origin/HEAD 2>/dev/null || true
    else
        log_info "Cloning repository (shallow --depth 1): ${slug}"
        rm -rf "$cache_dir"
        git clone --depth 1 --quiet "$clone_url" "$cache_dir"
    fi

    log_ok "Repository ready in cache: ${cache_dir}"

    # Print summary metadata as JSON
    generate_summary "$slug" "$cache_dir"
}

generate_summary() {
    local slug="$1"
    local cache_dir="$2"

    python3 - <<EOF
import os
import json
import glob

slug = "$slug"
cache_dir = "$cache_dir"

ext_counts = {}
ignored_dirs = {'.git', 'node_modules', 'vendor', 'target', 'build', 'dist', '.idea', '.vscode', '__pycache__'}

total_files = 0
for root, dirs, files in os.walk(cache_dir):
    dirs[:] = [d for d in dirs if d not in ignored_dirs]
    for f in files:
        total_files += 1
        _, ext = os.path.splitext(f)
        ext = ext.lower()
        if ext:
            ext_counts[ext] = ext_counts.get(ext, 0) + 1

sorted_exts = sorted(ext_counts.items(), key=lambda x: x[1], reverse=True)[:10]

entry_patterns = [
    "main.*", "index.*", "app.*", "server.*", "cli.*",
    "CMakeLists.txt", "Makefile", "Cargo.toml", "package.json", "go.mod",
    "setup.py", "pyproject.toml", "pom.xml", "build.gradle", "Dockerfile"
]
entry_points = []
for p in entry_patterns:
    for match in glob.glob(os.path.join(cache_dir, p)):
        entry_points.append(os.path.relpath(match, cache_dir))
    for match in glob.glob(os.path.join(cache_dir, "src", p)):
        entry_points.append(os.path.relpath(match, cache_dir))
    for match in glob.glob(os.path.join(cache_dir, "cmd", "*", p)):
        entry_points.append(os.path.relpath(match, cache_dir))

docs = []
for doc in ["README*", "ARCHITECTURE*", "DESIGN*", "CONTRIBUTING*", "docs"]:
    for match in glob.glob(os.path.join(cache_dir, doc)):
        docs.append(os.path.relpath(match, cache_dir))

data = {
    "status": "success",
    "slug": slug,
    "cache_dir": cache_dir,
    "total_files": total_files,
    "top_extensions": dict(sorted_exts),
    "entry_points": sorted(list(set(entry_points))),
    "doc_files": sorted(list(set(docs)))
}

print(json.dumps(data, indent=2))
EOF
}

cmd_tree() {
    local target="${1:-}"
    local max_depth="${2:-2}"

    if [[ -z "$target" ]]; then
        log_err "Usage: know-it tree <github-url-or-slug> [max-depth]"
        exit 1
    fi

    local slug
    slug=$(normalize_repo "$target")
    local cache_dir
    cache_dir=$(get_cache_path "$slug")

    if [[ ! -d "$cache_dir" ]]; then
        log_warn "Repository not cached yet. Fetching first..."
        cmd_fetch "$slug" >/dev/null
    fi

    python3 - <<EOF
import os

cache_dir = "$cache_dir"
max_depth = int("$max_depth")
ignored = {'.git', 'node_modules', 'vendor', 'target', 'build', 'dist', '.idea', '.vscode', '__pycache__'}

def print_tree(dir_path, prefix="", current_depth=1):
    if current_depth > max_depth:
        return
    try:
        entries = sorted([e for e in os.listdir(dir_path) if e not in ignored])
    except PermissionError:
        return

    entries_count = len(entries)
    for index, entry in enumerate(entries):
        is_last = (index == entries_count - 1)
        connector = "└── " if is_last else "├── "
        full_path = os.path.join(dir_path, entry)
        
        if os.path.isdir(full_path):
            print(f"{prefix}{connector}{entry}/")
            sub_prefix = prefix + ("    " if is_last else "│   ")
            print_tree(full_path, sub_prefix, current_depth + 1)
        else:
            print(f"{prefix}{connector}{entry}")

print(f"$slug/ (cached in {cache_dir})")
print_tree(cache_dir)
EOF
}

cmd_inspect() {
    local target="${1:-}"
    local rel_file="${2:-}"

    if [[ -z "$target" || -z "$rel_file" ]]; then
        log_err "Usage: know-it inspect <github-url-or-slug> <relative-file-path>"
        exit 1
    fi

    local slug
    slug=$(normalize_repo "$target")
    local cache_dir
    cache_dir=$(get_cache_path "$slug")

    if [[ ! -d "$cache_dir" ]]; then
        cmd_fetch "$slug" >/dev/null
    fi

    local target_file="${cache_dir}/${rel_file}"
    if [[ ! -f "$target_file" ]]; then
        log_err "File not found in cached repo: $rel_file"
        exit 1
    fi

    awk '{printf "%4d | %s\n", NR, $0}' "$target_file"
}

cmd_list() {
    echo -e "${BOLD}Cached Repositories in ${CACHE_BASE}:${RESET}"
    if [[ ! -d "$CACHE_BASE" ]]; then
        echo "  (None)"
        return
    fi

    local found=0
    while IFS= read -r -d '' repo_dir; do
        local rel_path="${repo_dir#$CACHE_BASE/}"
        local count
        count=$(find "$repo_dir" -maxdepth 3 -not -path '*/.*' | wc -l)
        local du_size
        du_size=$(du -sh "$repo_dir" 2>/dev/null | cut -f1)
        echo -e "  • ${CYAN}${rel_path}${RESET} (${du_size}, ~${count} files)"
        found=1
    done < <(find "$CACHE_BASE" -mindepth 2 -maxdepth 2 -type d -print0 2>/dev/null)

    if [[ "$found" -eq 0 ]]; then
        echo "  (None)"
    fi
}

cmd_clean() {
    local target="${1:-}"
    if [[ -z "$target" || "$target" == "--all" ]]; then
        read -r -p "Clean all cached repositories in $CACHE_BASE? [y/N] " confirm
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
            rm -rf "$CACHE_BASE"
            log_ok "Cache cleared."
        fi
    else
        local slug
        slug=$(normalize_repo "$target")
        local cache_dir
        cache_dir=$(get_cache_path "$slug")
        if [[ -d "$cache_dir" ]]; then
            rm -rf "$cache_dir"
            log_ok "Removed ${slug} from cache."
        else
            log_warn "Repository not found in cache: ${slug}"
        fi
    fi
}

cmd_info() {
    echo -e "${BOLD}know-it v${VERSION} - Agent Skill Integration Status${RESET}"
    echo ""

    check_agent() {
        local name="$1"
        local path="$2"
        if [[ -e "$path" ]]; then
            echo -e "  [${GREEN}✓${RESET}] ${BOLD}${name}${RESET}: Installed at ${path}"
        else
            echo -e "  [ ] ${BOLD}${name}${RESET}: Not installed (${path})"
        fi
    }

    check_agent "Claude Code Commands" "$HOME/.claude/commands/how.md"
    check_agent "Claude Code Skill"    "$HOME/.claude/skills/know-it/SKILL.md"
    check_agent "Antigravity Skill"     "$HOME/.gemini/config/skills/know-it/SKILL.md"
    check_agent "OpenCode Commands"    "$HOME/.config/opencode/commands/how.md"
    check_agent "OpenCode Skill"       "$HOME/.config/opencode/skills/know-it/SKILL.md"
    check_agent "Codex Skill"          "$HOME/.codex/skills/know-it/SKILL.md"
    check_agent "AgentSkills Generic"  "$HOME/.agentskills/know-it/SKILL.md"
    check_agent "Cursor Rules"         "$HOME/.cursor/rules/know-it.md"
    check_agent "Windsurf Rules"       "$HOME/.windsurf/rules/know-it.md"
    echo ""
    echo -e "Cache directory: ${CYAN}${CACHE_BASE}${RESET}"
}

cmd_help() {
    cat <<EOF
know-it - Intelligent GitHub repo comprehension & architecture engine

Usage:
  know-it fetch <github-url-or-slug>       Clone/update repo into local cache and return JSON summary
  know-it tree <github-url-or-slug> [depth] Print ASCII directory tree of cached repo
  know-it inspect <slug> <file-path>       View file contents from cached repo with line numbers
  know-it list                             List all repositories currently in local cache
  know-it clean [slug|--all]               Remove repository or entire cache
  know-it info                             Show installed agent skills and status
  know-it version                          Print version
  know-it help                             Show this help message

Examples:
  know-it fetch ettercap/ettercap
  know-it tree ettercap/ettercap 2
  know-it inspect ettercap/ettercap src/ec_main.c
EOF
}

case "${1:-help}" in
    fetch)
        shift
        cmd_fetch "$@"
        ;;
    tree)
        shift
        cmd_tree "$@"
        ;;
    inspect)
        shift
        cmd_inspect "$@"
        ;;
    list)
        cmd_list
        ;;
    clean)
        shift
        cmd_clean "$@"
        ;;
    info)
        cmd_info
        ;;
    version|-v|--version)
        echo "know-it v${VERSION}"
        ;;
    help|-h|--help)
        cmd_help
        ;;
    *)
        log_err "Unknown command: $1"
        cmd_help
        exit 1
        ;;
esac
